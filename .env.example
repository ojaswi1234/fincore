# FinCore Environment Configuration Example
DB_NAME=fincore_db
DB_USERNAME=fincore_user
DB_PASSWORD=fincore_pass
DB_URL=jdbc:postgresql://localhost:5432/fincore_db
SERVER_PORT=8080
FINCORE_CURRENCY_DEFAULT=INR
FINCORE_FRAUD_HIGH_VALUE_THRESHOLD=200000.00
FINCORE_FRAUD_VELOCITY_TIME_WINDOW_SECONDS=60
FINCORE_FRAUD_VELOCITY_MAX_TRANSFERS=3
